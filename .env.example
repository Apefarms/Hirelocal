# ==============================================================================
# Sri city Jobs Portal - Environment Variables Template
#
# LOCAL DEVELOPMENT:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. Fill in your local development configuration.
#
# PRODUCTION (VERCEL + TIDB CLOUD):
# Configure these variables in Vercel Project Settings -> Environment Variables.
# NOTE: Never commit secret keys or production passwords to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (MySQL / TiDB Cloud)
# ------------------------------------------------------------------------------
# Local: localhost | TiDB Cloud: gateway01.us-east-1.prod.aws.tidbcloud.com (or your cluster host)
DB_HOST=localhost

# Standard MySQL port (3306 for local MySQL and 4000 or 3306 for TiDB Cloud)
DB_PORT=3306

# Database user (e.g. root for local, or xxxxx.root for TiDB Cloud)
DB_USER=root

# Database user password
DB_PASSWORD=

# Database name (e.g. job_portal)
DB_NAME=job_portal

# Enable TLS/SSL for TiDB Cloud.
# Set to 'true' for TiDB Cloud (auto-detected if DB_HOST contains tidbcloud.com). Set to 'false' for local MySQL without SSL.
DB_SSL=false

# Maximum connection pool size (recommended 5-10 for Vercel serverless functions)
DB_CONNECTION_LIMIT=10

# ------------------------------------------------------------------------------
# 2. Razorpay Payment Gateway Configuration (Optional)
# ------------------------------------------------------------------------------
# Client-accessible Razorpay Key ID
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Server-side Razorpay Key ID (fallback for backend order creation)
RAZORPAY_KEY_ID=

# Server-only Razorpay Secret Key (CRITICAL: Never expose to browser / NEVER prefix with NEXT_PUBLIC_)
RAZORPAY_KEY_SECRET=

# ------------------------------------------------------------------------------
# 3. Google Drive / External Storage Configuration
# ------------------------------------------------------------------------------
# Target Google Drive Folder ID for uploaded resumes
GOOGLE_DRIVE_FOLDER_ID=

# RECOMMENDED FOR VERCEL: Google Apps Script Web App Endpoint URL
# Bypasses Google Service Account 0-byte quota restrictions on personal Google Drives
GOOGLE_APPS_SCRIPT_URL=

# OPTIONAL ALTERNATIVE: Google Cloud Service Account (for Google Workspace Shared Drives)
# GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 4. OCR Configuration (Local Development Only)
# ------------------------------------------------------------------------------
# Path to local Tesseract OCR binary (Windows local dev only; leave unset on Vercel)
# TESSERACT_PATH="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
